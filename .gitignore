# --- Swift & SPM ---
.build/
/Packages

# This App/CLI repository uses Tuist for the project graph.
# Keep Tuist/Package.swift and Tuist/Package.resolved tracked; root SwiftPM
# manifests are local mistakes here. SDK repositories should not copy this rule.
/Package.swift
/Package.resolved
*.swiftmodule
*.swiftdoc
*.swiftinterface

# --- Xcode ---
DerivedData/
*.xcodeproj
*.xcworkspace
*.xcresult
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
*.moved-aside
*.swp
*.lock
/xcuserdata/

# --- Tuist ---
# Ignore generated Xcode projects and workspaces
# (Keep manifests like Project.swift and Tuist.swift)
/Derived/
/.tuist/
/graph.dot
/.build-tuist/
.tools/

# --- macOS ---
.DS_Store
.AppleDouble
.LSOverride
Icon
Network Trash Folder
Temporary Items
.apdisk

# --- IDEs ---
.vscode/
.idea/
*.swp
*.swo

# Project-local MCP config (generated by bootstrap scripts)
.cursor/

# --- iDocs Specific ---
# Ignore local development cache
~/Library/Caches/iDocs/

# Ignore large data directories if they are not part of the core repo
corrival/

# --- Test & Coverage ---
coverage_report/
.xcresult/
*.profraw
.deriveddata/
.deriveddata-coverage/
npm/*.tgz
dist/release/
npm/lib/
npm/dist/*
!npm/dist/.gitkeep
npm/bin/idocs
release-input/

# --- Node / JS ---
node_modules/
dist/
build/
*.log
.env
.env.*

# --- Local agent/runtime artifacts ---
.codex/

# --- Benchmark runtime artifacts ---
/scripts/benchmark/artifacts/
# Existing checkouts can still contain ignored runs from before the migration.
/specs/008-mcp-service-benchmark/artifacts/
