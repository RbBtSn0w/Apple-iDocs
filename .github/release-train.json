{
  "schema_version": 2,
  "profile": "custom",
  "adapter": "scripts/release/train-adapter.mjs",
  "intended_targets": [
    "stable_tag",
    "github",
    "npm",
    "github-packages",
    "homebrew"
  ],
  "protocol_version": 1,
  "cadence": {
    "schedule": {
      "enabled": true,
      "cron": "0 15 * * 5",
      "timezone": "Asia/Singapore"
    },
    "manual": {
      "enabled": true
    }
  },
  "pipeline": {
    "stages": [
      {
        "id": "validate",
        "implementation": "product",
        "operation": "execute",
        "effect": "local",
        "depends_on": [],
        "inputs": [],
        "outputs": [
          {
            "role": "native-archive",
            "kind": "files"
          },
          {
            "role": "wrapper",
            "kind": "files"
          }
        ],
        "execution": {
          "provider": "github-actions",
          "job": "verify"
        },
        "when": "release-needed"
      },
      {
        "id": "engine",
        "implementation": "semantic-release",
        "operation": "execute",
        "effect": "write",
        "depends_on": [
          "validate"
        ],
        "inputs": [],
        "outputs": [
          {
            "role": "release-source",
            "kind": "source"
          }
        ],
        "execution": {
          "provider": "github-actions",
          "job": "release"
        },
        "when": "release-needed"
      },
      {
        "id": "native-assets",
        "implementation": "github",
        "operation": "execute",
        "effect": "write",
        "depends_on": [
          "engine"
        ],
        "inputs": [
          {
            "from_stage": "validate",
            "role": "native-archive",
            "kind": "files"
          }
        ],
        "outputs": [],
        "execution": {
          "provider": "github-actions",
          "job": "release"
        },
        "when": "release-needed"
      },
      {
        "id": "npm",
        "implementation": "registry",
        "operation": "execute",
        "effect": "write",
        "depends_on": [
          "native-assets"
        ],
        "inputs": [
          {
            "from_stage": "validate",
            "role": "wrapper",
            "kind": "files"
          }
        ],
        "outputs": [],
        "execution": {
          "provider": "github-actions",
          "job": "release"
        },
        "when": "release-needed"
      },
      {
        "id": "github-packages",
        "implementation": "registry",
        "operation": "execute",
        "effect": "write",
        "depends_on": [
          "npm"
        ],
        "inputs": [
          {
            "from_stage": "validate",
            "role": "wrapper",
            "kind": "files"
          }
        ],
        "outputs": [],
        "execution": {
          "provider": "github-actions",
          "job": "release"
        },
        "when": "release-needed"
      },
      {
        "id": "homebrew",
        "implementation": "homebrew",
        "operation": "execute",
        "effect": "write",
        "depends_on": [
          "github-packages"
        ],
        "inputs": [],
        "outputs": [],
        "execution": {
          "provider": "github-actions",
          "job": "publish-homebrew"
        },
        "when": "release-needed"
      }
    ],
    "goals": [
      {
        "id": "stable_tag",
        "stages": [
          "engine"
        ],
        "asynchronous": false,
        "recovery": "supported"
      },
      {
        "id": "github",
        "stages": [
          "native-assets"
        ],
        "asynchronous": false,
        "recovery": "supported"
      },
      {
        "id": "npm",
        "stages": [
          "npm"
        ],
        "asynchronous": false,
        "recovery": "supported"
      },
      {
        "id": "github-packages",
        "stages": [
          "github-packages"
        ],
        "asynchronous": false,
        "recovery": "supported"
      },
      {
        "id": "homebrew",
        "stages": [
          "homebrew"
        ],
        "asynchronous": false,
        "recovery": "supported"
      }
    ]
  }
}
